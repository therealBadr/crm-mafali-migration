@inherits LayoutComponentBase
@using System.Security.Claims
@inject NavigationManager Nav
@implements IDisposable

<div class="app-shell">
    <header class="topbar">
        <span class="brand">
            <span class="brand-mark">M</span>
            Mafali CRM
        </span>
        <nav class="nav-links">
            <div class="nav-dropdown">
                <button type="button" class="nav-link nav-dropdown-toggle" @onclick="ToggleFichiers">
                    Fichiers
                    <span class="nav-caret">@(FichiersOpen ? "▴" : "▾")</span>
                </button>
                @if (FichiersOpen)
                {
                    <div class="nav-dropdown-panel">
                        @foreach (var item in FichierItems)
                        {
                            <NavLink href="@item.Href" class="nav-dropdown-item" ActiveClass="nav-dropdown-item-active">
                                @item.Label
                            </NavLink>
                        }
                        <AuthorizeView Roles="admin">
                            <Authorized>
                                @* Utilisateurs used to be here — moved into Mon Compte
                                   (2026-08-19, Badr: "admins never leave this page"),
                                   not duplicated, so no separate nav entry for it
                                   anymore. Mon Compte itself is already reachable
                                   from the account menu on the right. *@
                                <NavLink href="/historique-connexions" class="nav-dropdown-item" ActiveClass="nav-dropdown-item-active">
                                    Historique des Connexions
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
            <NavLink href="/definir-filtre" class="nav-link" ActiveClass="nav-link-active">
                Définir un Filtre
            </NavLink>
            <NavLink href="/filtres-predefinis" class="nav-link" ActiveClass="nav-link-active">
                Filtres Prédéfinis
            </NavLink>
            <NavLink href="/recherche-client" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                Rechercher un Client
            </NavLink>
            <NavLink href="/rappels" class="nav-link" ActiveClass="nav-link-active">
                Rappels
            </NavLink>
            <NavLink href="/bon-commande" class="nav-link" ActiveClass="nav-link-active">
                Bon de Commande
            </NavLink>
        </nav>
        <div class="nav-user">
            <AuthorizeView>
                <Authorized>
                    <span class="nav-user-name">
                        @context.User.Identity?.Name (@Capitalize(context.User.FindFirst(ClaimTypes.Role)?.Value))
                    </span>
                    <NavLink href="/mon-compte" class="nav-link">Mon Compte</NavLink>
                    @*
                        Plain form POST, not @onclick — same reason as
                        Login.razor: HttpContext.SignOutAsync needs a live,
                        writable HTTP response, which the Blazor Server
                        SignalR circuit no longer has once it's running.
                    *@
                    <form method="post" action="logout">
                        <button type="submit" class="nav-link nav-logout-btn">Déconnexion</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="app-body">
        @Body
    </main>
</div>

@if (FichiersOpen)
{
    <div class="nav-dropdown-backdrop" @onclick="CloseFichiers"></div>
}

<div id="blazor-error-ui">
    Une erreur inattendue s'est produite.
    <a href="" class="reload">Recharger</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool FichiersOpen;

    private static string Capitalize(string? s) =>
        string.IsNullOrEmpty(s) ? "" : char.ToUpper(s[0]) + s[1..];

    // Pages register themselves here as we build them. No central route
    // table elsewhere to keep in sync — Familles.razor's own @page "/familles"
    // is what actually makes the route work; this list is just the dropdown UI.
    private readonly List<(string Href, string Label)> FichierItems = new()
    {
        ("/clients", "Fichier des Clients"),
        ("/familles", "Fichier des Familles"),
        ("/franchises", "Fichier des Franchises"),
        ("/pays", "Liste Pays"),
        ("/assistantes", "Fichier des Assistantes"),
        ("/fichier-filtres", "Fichier des Filtres"),
        ("/fichier-historique", "Fichier des Historiques"),
    };

    private void ToggleFichiers() => FichiersOpen = !FichiersOpen;
    private void CloseFichiers() => FichiersOpen = false;

    // Each dropdown item used to close the menu via its own @onclick
    // ("CloseFichiers") on the exact same click that also had to navigate
    // it away — two separate things racing on one event: a server round
    // trip to flip FichiersOpen (which unmounts the panel, including the
    // link just clicked) versus the navigation itself. Closing on
    // LocationChanged instead reacts to navigation actually happening,
    // rather than competing with it.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (FichiersOpen)
        {
            FichiersOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
