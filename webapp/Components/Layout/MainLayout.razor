@inherits LayoutComponentBase
@using System.Security.Claims
@inject NavigationManager Nav
@implements IDisposable

<div class="app-shell">
    <header class="topbar">
        @* Now a real link, not just a label — "/" became an actual
           dashboard page (2026-09-19) instead of a pure redirect, so
           there's finally somewhere meaningful for the brand to point. *@
        <a href="/" class="brand">
            <span class="brand-word">Mafali</span>
            <span class="brand-suffix">CRM</span>
        </a>
        <nav class="nav-links">
            @* Every item currently behind this dropdown (Fichier des Clients/
               Familles/Franchises/Pays/Assistantes/Filtres/Filtres Historique/
               Historiques) is admin/assistant-only (2026-09-03 permissions
               pass) — none of them are reachable by Commercial, so the whole
               dropdown button is hidden for that role rather than opening to
               an empty panel. *@
            <AuthorizeView Roles="admin,assistant">
                <Authorized>
                    <div class="nav-dropdown">
                        <button type="button" class="nav-link nav-dropdown-toggle" @onclick="ToggleFichiers">
                            Fichiers
                            <span class="nav-caret">@(FichiersOpen ? "▴" : "▾")</span>
                        </button>
                        @if (FichiersOpen)
                        {
                            <div class="nav-dropdown-panel">
                                @foreach (var item in FichierItems)
                                {
                                    <NavLink href="@item.Href" class="nav-dropdown-item" ActiveClass="nav-dropdown-item-active" target="_blank">
                                        @item.Label
                                    </NavLink>
                                }
                                <AuthorizeView Roles="admin">
                                    <Authorized Context="adminContext">
                                        @* Utilisateurs used to be here — moved into Mon Compte
                                           (2026-08-19, Badr: "admins never leave this page"),
                                           not duplicated, so no separate nav entry for it
                                           anymore. Mon Compte itself is already reachable
                                           from the account menu on the right. *@
                                        <NavLink href="/historique-connexions" class="nav-dropdown-item" ActiveClass="nav-dropdown-item-active" target="_blank">
                                            Historique des Connexions
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="admin,assistant">
                <Authorized>
                    <NavLink href="/definir-filtre" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                        Définir un Filtre
                    </NavLink>
                    <NavLink href="/definir-filtre-historique" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                        Définir un Filtre Historique
                    </NavLink>
                </Authorized>
            </AuthorizeView>
            <NavLink href="/filtres-predefinis" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                Filtres Prédéfinis
            </NavLink>
            <NavLink href="/recherche-client" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                Rechercher un Client
            </NavLink>
            <NavLink href="/rappels" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                Rappels
            </NavLink>
            <NavLink href="/bon-commande" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                Bon de Commande
            </NavLink>
            @* Was a "Nouveau" button on Parcours Client itself — moved here
               (2026-09-22, Badr) since it just navigates to /clients/new
               regardless of which client happens to be loaded on that page.
               Same role gate as /clients/new itself (ClientForm.razor:
               admin,assistant) so this link never appears for a role that
               would just get denied on the page it points to. *@
            <AuthorizeView Roles="admin,assistant">
                <Authorized>
                    <NavLink href="/clients/new" class="nav-link" ActiveClass="nav-link-active" target="_blank">
                        Ajouter un Client
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="nav-user">
            <AuthorizeView>
                <Authorized>
                    <span class="nav-user-name">
                        @context.User.Identity?.Name (@Capitalize(context.User.FindFirst(ClaimTypes.Role)?.Value))
                    </span>
                    <NavLink href="/mon-compte" class="nav-link" target="_blank">Mon Compte</NavLink>
                    @*
                        Plain form POST, not @onclick — same reason as
                        Login.razor: HttpContext.SignOutAsync needs a live,
                        writable HTTP response, which the Blazor Server
                        SignalR circuit no longer has once it's running.
                    *@
                    <form method="post" action="logout">
                        <button type="submit" class="nav-link nav-logout-btn">Déconnexion</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="app-body">
        @Body
    </main>
</div>

@if (FichiersOpen)
{
    <div class="nav-dropdown-backdrop" @onclick="CloseFichiers"></div>
}

<div id="blazor-error-ui">
    Une erreur inattendue s'est produite.
    <a href="" class="reload">Recharger</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool FichiersOpen;

    private static string Capitalize(string? s) =>
        string.IsNullOrEmpty(s) ? "" : char.ToUpper(s[0]) + s[1..];

    // Pages register themselves here as we build them. No central route
    // table elsewhere to keep in sync — Familles.razor's own @page "/familles"
    // is what actually makes the route work; this list is just the dropdown UI.
    private readonly List<(string Href, string Label)> FichierItems = new()
    {
        ("/clients", "Fichier des Clients"),
        ("/familles", "Fichier des Familles"),
        ("/franchises", "Fichier des Franchises"),
        ("/pays", "Liste Pays"),
        ("/assistantes", "Fichier des Assistantes"),
        ("/fichier-filtres", "Fichier des Filtres"),
        ("/fichier-filtres-historique", "Fichier des Filtres Historique"),
        ("/fichier-historique", "Fichier des Historiques"),
    };

    private void ToggleFichiers() => FichiersOpen = !FichiersOpen;
    private void CloseFichiers() => FichiersOpen = false;

    // Each dropdown item used to close the menu via its own @onclick
    // ("CloseFichiers") on the exact same click that also had to navigate
    // it away — two separate things racing on one event: a server round
    // trip to flip FichiersOpen (which unmounts the panel, including the
    // link just clicked) versus the navigation itself. Closing on
    // LocationChanged instead reacts to navigation actually happening,
    // rather than competing with it.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (FichiersOpen)
        {
            FichiersOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
