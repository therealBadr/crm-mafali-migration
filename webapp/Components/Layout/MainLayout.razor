@inherits LayoutComponentBase

<div class="app-shell">
    <header class="topbar">
        <span class="brand">Mafali CRM</span>
        <nav class="nav-links">
            @foreach (var item in NavItems)
            {
                <NavLink href="@item.Href" class="nav-link" ActiveClass="nav-link-active">
                    @item.Label
                </NavLink>
            }
        </nav>
    </header>
    <main class="app-body">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Pages register themselves here as we build them. No central route
    // table elsewhere to keep in sync — Familles.razor's own @page "/familles"
    // is what actually makes the route work; this list is just the nav UI.
    private readonly List<(string Href, string Label)> NavItems = new()
    {
        ("/clients", "Fichier des Clients"),
        ("/familles", "Fichier des Familles"),
        ("/franchises", "Fichier des Franchises"),
        ("/pays", "Liste Pays"),
        ("/assistantes", "Fichier des Assistantes"),
    };
}
