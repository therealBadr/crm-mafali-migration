@page "/clients"
@attribute [Authorize(Roles = "admin,assistant")]
@inject ClientService ClientSvc
@inject ClientImportExportService ImportExportSvc
@inject CurrentUserService CurrentUserSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Clients</PageTitle>

<div class="page page-flush">
<div class="toolbar">
    <span class="title">Table des Clients</span>
    <div class="actions">
        <button class="btn btn-primary" @onclick="OpenCreate">Nouveau</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="OpenEdit">Modifier</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="OpenDeleteConfirm">Supprimer</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="() => OpenParcours(Selected)">Parcours Client</button>
        <button class="btn btn-outline" disabled="@ExportingOrImporting" @onclick="Export">@(ExportingOrImporting ? "Export en cours…" : "Exporter")</button>
        @if (IsAdmin)
        {
            <label class="btn btn-outline" for="import-file-input"
                   style="@(ExportingOrImporting ? "opacity:0.55;cursor:not-allowed;pointer-events:none;" : "")">Importer</label>
            <InputFile id="import-file-input" style="display:none" OnChange="HandleImportFile" accept=".xlsx" />
        }
    </div>
</div>

<div class="search-bar">
    <select class="search-input" style="min-width: 200px;" value="@SearchColumn" @onchange="OnSearchColumnChange">
        @foreach (var col in Columns)
        {
            <option value="@col.Key">@col.Label</option>
        }
    </select>
    <input class="search-input" type="text" placeholder="Rechercher…" value="@SearchTerm" @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(SearchTerm))
    {
        <span class="result-count">@Filtered.Count / @Items.Count résultats</span>
    }
</div>

@if (Error is not null)
{
    <div class="alert">@Error</div>
}

@if (Loading)
{
    <p class="dimmed">Chargement…</p>
}
else
{
    <GridFilterClearAll Filter="Filter" OnFilterChanged="StateHasChanged" />
    <div class="table-wrap" style="overflow-x: auto;">
        <div style="@GridLayout.WrapperStyle(TotalWidth)">
            <div class="header-row" style="position: sticky; top: 0;" @ref="HeaderRowRef">
                @foreach (var col in Columns)
                {
                    <div class="cell" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])">
                        <span class="col-sort-label @Sort.CssClass(col.Key)" @onclick='() => Sort.Toggle(col.Key)'>@col.Label @Sort.ArrowFor(col.Key)</span>
                        <ColumnFilterIcon Column="@col.Key" Label="@col.Label" Filter="Filter" OnFilterChanged="StateHasChanged" />
                        <span class="col-resize-handle" data-col-key="@col.Key"></span>
                    </div>
                }
            </div>
            <Virtualize Items="Filtered" Context="c" ItemSize="34">
                <div class="row @(c.CleOpl == Selected ? "selected" : "")"
                     @onclick="() => Select(c.CleOpl)" @ondblclick="() => OpenParcours(c.CleOpl)">
                    @foreach (var col in Columns)
                    {
                        <div class="cell" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])">
                            @if (col.Key == "statuts_clients" && StatutBadgeClass(c.StatutsClients) is { Length: > 0 } badgeClass)
                            {
                                <span class="badge @badgeClass">@c.StatutsClients</span>
                            }
                            @* Badge only for 'pending' — the other 93,000+ rows
                               are 'validated', and a green badge on every one
                               of them would be pure noise. The column reads as
                               "needs attention", blank meaning nothing to do.
                               'refused' can't appear here at all: the global
                               query filter in AppDbContext hides it. *@
                            else if (col.Key == "validation_status")
                            {
                                @if (c.ValidationStatus == "pending")
                                {
                                    <span class="badge badge-info">Non validé</span>
                                }
                            }
                            else
                            {
                                @GetCellText(c, col.Key)
                            }
                        </div>
                    }
                </div>
            </Virtualize>
        </div>
    </div>
    <p class="count">@Items.Count enregistrements</p>
}
</div>

@if (ImportResultOpen && ImportSummary is not null)
{
    <div class="modal-backdrop" @onclick="() => ImportResultOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Résultat de l'import</h3>
            <p class="confirm-text">
                @ImportSummary.Added ajoutés · @ImportSummary.Modified modifiés ·
                @ImportSummary.Unchanged inchangés
            </p>
            @{ var invalidLines = ImportSummary.InvalidReferenceCounts.Where(kv => kv.Value > 0).ToList(); }
            @if (invalidLines.Count > 0)
            {
                <p class="confirm-text">
                    Valeurs non reconnues ignorées :
                    @string.Join(" · ", invalidLines.Select(kv => $"{kv.Key} ({kv.Value})"))
                </p>
            }
            @if (ImportSummary.SkippedRows.Count > 0)
            {
                <div class="conflict-list">
                    @foreach (var line in ImportSummary.SkippedRows)
                    {
                        <div class="conflict-row">@line</div>
                    }
                </div>
            }
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="() => ImportResultOpen = false">Fermer</button>
            </div>
        </div>
    </div>
}

@if (ConfirmDeleteOpen)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Confirmer la suppression</h3>
            <p class="confirm-text">Êtes-vous sûr de vouloir supprimer ce client ?</p>
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="CancelDelete">Annuler</button>
                <button class="btn btn-primary" disabled="@Submitting" @onclick="ConfirmDelete">Supprimer</button>
            </div>
        </div>
    </div>
}

@code {
    // A class, not a record — Width needs to be mutable for column resize
    // (records default positional properties to init-only).
    private class ColumnDef
    {
        public string Key { get; }
        public string Label { get; }
        public int Width { get; set; }

        public ColumnDef(string key, string label, int width)
        {
            Key = key;
            Label = label;
            Width = width;
        }
    }

    private readonly List<ColumnDef> Columns = new()
    {
        new("cle_opl", "Cle Opl", 80),
        new("famille", "Famille", 140),
        new("raison_sociale", "Raison Sociale", 200),
        new("complement", "Complement", 160),
        new("franchise", "Franchise", 140),
        new("franchise2", "Franchise 2", 140),
        new("franchise3", "Franchise 3", 140),
        new("franchise4", "Franchise 4", 140),
        new("rue", "Rue", 160),
        new("localisation_1", "Localisation 1", 140),
        new("localisation_2", "Localisation 2", 140),
        new("cp", "Code Postal", 90),
        new("ville", "Ville", 140),
        new("pays", "Pays", 120),
        new("telephone", "Telephone", 110),
        new("portable", "Portable", 110),
        new("email", "Email", 180),
        new("assistante_commercial", "Assistante Commerciale", 180),
        new("magasin_principal", "Magasin Principal", 160),
        new("statuts_clients", "Statuts Clients", 140),
        new("representant", "Représentant", 160),
        new("responsable_achat", "Responsable Achat", 160),
        new("op_en_cours", "Opération en Cours", 160),
        new("status_vente", "Status Vente", 140),
        new("date_saisie", "Date Saisie", 100),
        new("heure_saisie", "Heure Saisie", 90),
        new("date_rappel", "Date Rappel", 100),
        new("heure_rappel", "Heure Rappel", 90),
        new("note_perm", "Note Permanente", 200),
        new("etat_client", "État Client", 140),
        new("validation_status", "Validation", 110),
    };

    private int TotalWidth => Columns.Sum(c => c.Width);

    private List<FranceOptique> Items = new();
    private long? Selected;
    private string SearchColumn = "raison_sociale";
    private string SearchTerm = string.Empty;
    private bool Loading = true;
    private bool Submitting;
    private string? Error;
    private bool ExportingOrImporting;
    private bool ImportResultOpen;
    private ImportResult? ImportSummary;
    private bool IsAdmin;
    private readonly SortState Sort = new();
    private readonly GridFilterState Filter = new();

    private List<FranceOptique> Filtered
    {
        get
        {
            var list = string.IsNullOrWhiteSpace(SearchTerm)
                ? Items
                : Items.Where(c => GetCellText(c, SearchColumn).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
            list = GridFilter.Apply(list, Filter, GetCellText);
            return GridSort.Apply(list, Sort, GetCellText);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        IsAdmin = await CurrentUserSvc.IsAdminAsync();
        await Load();
    }

    private ElementReference HeaderRowRef;
    private DotNetObjectReference<Clients>? ResizeDotNetRef;
    private bool ResizeAttached;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Guarded by ResizeAttached, not firstRender alone: HeaderRowRef only
        // exists once Loading has flipped false and the real header markup
        // has actually rendered — the first render (still showing
        // "Chargement…") has no header row to attach to yet.
        if (!ResizeAttached && !Loading)
        {
            ResizeAttached = true;
            ResizeDotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mafaliColumnResize.attach", HeaderRowRef, ResizeDotNetRef);
        }
    }

    [JSInvokable]
    public void OnColumnResized(string key, int width)
    {
        var col = Columns.FirstOrDefault(c => c.Key == key);
        if (col is null) return;
        col.Width = width;
        StateHasChanged();
    }

    public class ColumnAutoFitData
    {
        public string Header { get; set; } = "";
        public List<string> Values { get; set; } = new();
    }

    // Blazor Server has no client-side data model to measure text against —
    // the browser only ever sees rendered HTML — so double-click auto-fit
    // asks for this one column's actual values (JS can't reach Filtered
    // itself) and measures them client-side, where real font metrics exist.
    // Uses Filtered, not Items: "longest content" should mean longest of
    // what's currently showing, respecting any active search.
    [JSInvokable]
    public ColumnAutoFitData GetColumnAutoFitData(string key)
    {
        var col = Columns.FirstOrDefault(c => c.Key == key);
        return new ColumnAutoFitData
        {
            Header = col?.Label ?? "",
            Values = Filtered.Select(item => GetCellText(item, key)).ToList(),
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (ResizeAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("mafaliColumnResize.detach", HeaderRowRef);
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. tab closed) — nothing to clean up client-side.
            }
        }
        ResizeDotNetRef?.Dispose();
    }

    private async Task Load()
    {
        // Loading gates the @if that mounts the header-row element (see
        // markup above) — flipping it true then false (as every call here
        // from ConfirmDelete/HandleImportFile does, not just the initial
        // OnInitializedAsync call) tears down and rebuilds that DOM node,
        // so the resize listeners attached to the old one need to be
        // re-attached to the new one next render.
        ResizeAttached = false;
        Loading = true;
        Selected = null;
        try
        {
            Items = await ClientSvc.ListAsync();
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Loading = false;
        }
    }

    private void OnSearchColumnChange(ChangeEventArgs e)
    {
        SearchColumn = e.Value?.ToString() ?? "raison_sociale";
        Selected = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        Selected = null;
    }

    private void Select(long cleOpl) => Selected = cleOpl;

    private void OpenCreate() => Nav.NavigateTo("/clients/new");

    private void OpenEdit()
    {
        if (Selected is null) return;
        Nav.NavigateTo($"/clients/{Selected}/edit");
    }

    // Opens Fen_Parcours_Client against the full client list (this grid's
    // own base order, not whatever search filter is currently narrowing the
    // view — the search bar here is a lightweight single-column filter, not
    // the legacy's real multi-field Fen_Recherche_Client, so it isn't
    // treated as defining a "result set" the way a saved Filtre is).
    private void OpenParcours(long? cleOpl)
    {
        if (cleOpl is null) return;
        Nav.NavigateTo($"/parcours-client?mode=clients&start={cleOpl}");
    }

    private bool ConfirmDeleteOpen;

    private void OpenDeleteConfirm()
    {
        if (Selected is null) return;
        ConfirmDeleteOpen = true;
    }

    private void CancelDelete() => ConfirmDeleteOpen = false;

    private async Task ConfirmDelete()
    {
        if (Selected is null) return;
        ConfirmDeleteOpen = false;
        Submitting = true;
        Error = null;
        try
        {
            await ClientSvc.DeleteAsync(Selected.Value);
            await Load();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Submitting = false;
        }
    }

    // Exports Filtered, not Items — same "export what I'm looking at"
    // behavior as the search bar's own scoping, matching how this app's
    // earlier (now-archived) export feature worked.
    private async Task Export()
    {
        ExportingOrImporting = true;
        Error = null;
        // StateHasChanged + Task.Yield here, not just the automatic
        // post-handler render Blazor would otherwise do — ImportExportSvc.
        // Export() below is entirely synchronous (no await inside it), so
        // without yielding first, the "disabled / Export en cours…" render
        // never actually reaches the browser until AFTER that call already
        // returns. Confirmed live: at 93,235 rows the export takes ~39s,
        // and without this the button visibly stayed enabled and unchanged
        // in the browser for the entire 39s (the pending render was stuck
        // behind the blocking call, not lost — just never flushed in time
        // to be seen) — indistinguishable from the page being frozen.
        StateHasChanged();
        await Task.Yield();
        try
        {
            // Task.Run, not a direct call — the Yield above only gets the
            // *initial* "busy" render out the door; ImportExportSvc.Export
            // is still ~30-40s of synchronous CPU-bound work at 93,235
            // rows, and running that directly on the circuit's own thread
            // blocks it from processing SignalR's keepalive for the whole
            // duration. Confirmed live: that alone was enough to trip a
            // "WebSocket closed (1006)" disconnect mid-export, abandoning
            // the download entirely — silently, no error shown, the user
            // just lands back wherever reconnection happens to put them.
            // Offloading to the thread pool keeps the circuit's own thread
            // free to answer keepalives while the real work happens
            // elsewhere.
            var bytes = await Task.Run(() => ImportExportSvc.Export(Filtered));
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            var fileName = $"clients_{DateTime.Now:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("mafaliFileDownload.downloadFileFromStream", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", streamRef);
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            ExportingOrImporting = false;
        }
    }

    // 20 MB cap: comfortably above any realistic client-list export (the
    // full 488-row export was well under 100 KB as plain data), just a
    // sanity ceiling against an accidental wrong-file upload — Blazor's own
    // OpenReadStream default (500 KB) is too small for a real .xlsx.
    private const long MaxImportFileSize = 20 * 1024 * 1024;

    // Buffered into a MemoryStream first: the browser-backed stream
    // InputFile hands back is forward-only, and ClosedXML's package reader
    // needs random access (seeking) to parse the .xlsx zip container.
    private async Task HandleImportFile(InputFileChangeEventArgs e)
    {
        // Backstop, not the real gate — the Importer control is only ever
        // rendered for admins (IsAdmin check above), so a non-admin has no
        // UI path to reach this handler at all. Checked again here anyway:
        // client-rendered-or-not is a UI convenience, not a security
        // boundary, and this is the one place that actually decides
        // whether the bulk write happens.
        if (!IsAdmin)
        {
            Error = "Seuls les administrateurs peuvent importer des clients.";
            return;
        }

        ExportingOrImporting = true;
        Error = null;
        try
        {
            using var buffered = new MemoryStream();
            await e.File.OpenReadStream(MaxImportFileSize).CopyToAsync(buffered);
            buffered.Position = 0;
            ImportSummary = await ImportExportSvc.ImportAsync(buffered);
            ImportResultOpen = true;
            await Load();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            ExportingOrImporting = false;
        }
    }

    private static string GetCellText(FranceOptique c, string key) => key switch
    {
        "cle_opl" => c.CleOpl.ToString(),
        "famille" => c.Famille ?? "",
        "raison_sociale" => c.RaisonSociale ?? "",
        "complement" => c.Complement ?? "",
        "franchise" => c.Franchise ?? "",
        "franchise2" => c.Franchise2 ?? "",
        "franchise3" => c.Franchise3 ?? "",
        "franchise4" => c.Franchise4 ?? "",
        "rue" => c.Rue ?? "",
        "localisation_1" => c.Localisation1 ?? "",
        "localisation_2" => c.Localisation2 ?? "",
        "cp" => c.Cp ?? "",
        "ville" => c.Ville ?? "",
        "pays" => c.Pays ?? "",
        "telephone" => c.Telephone ?? "",
        "portable" => c.Portable ?? "",
        "email" => c.Email ?? "",
        "assistante_commercial" => c.AssistanteCommercial ?? "",
        "magasin_principal" => c.MagasinPrincipal ?? "",
        "statuts_clients" => c.StatutsClients ?? "",
        "representant" => c.Representant ?? "",
        "responsable_achat" => c.ResponsableAchat ?? "",
        "op_en_cours" => c.OpEnCours ?? "",
        "status_vente" => c.StatusVente ?? "",
        "date_saisie" => c.DateSaisie?.ToString("dd/MM/yyyy") ?? "",
        "heure_saisie" => c.HeureSaisie?.ToString("HH:mm") ?? "",
        "date_rappel" => c.DateRappel?.ToString("dd/MM/yyyy") ?? "",
        "heure_rappel" => c.HeureRappel?.ToString("HH:mm") ?? "",
        "note_perm" => c.NotePerm ?? "",
        // No "Non défini" bucket anymore (2026-09-04) — anything that isn't
        // literally "1" reads as Prospect, including legacy junk ("0"/
        // blank/"-1"/typos) that was never explicitly set to Client.
        "etat_client" => c.EtatClient == "1" ? "Client" : "Prospect",
        // GridFilter/GridSort match on this text, so it has to equal what the
        // badge renders — per GridFilter.Apply's contract (a mismatch here is
        // exactly the class of bug fixed in the Assistantes "Oui"/"Non" case).
        "validation_status" => c.ValidationStatus == "pending" ? "Non validé" : "",
        _ => "",
    };

    private static string StatutBadgeClass(string? statut) => statut switch
    {
        "Payés" => "badge-success",
        "Impayés" => "badge-warning",
        "Bloqués" => "badge-danger",
        _ => "",
    };
}
