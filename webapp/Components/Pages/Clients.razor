@page "/clients"
@inject ClientService ClientSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Clients</PageTitle>

<div class="page">
<div class="toolbar">
    <span class="title">Table des Clients</span>
    <div class="actions">
        <button class="btn btn-primary" @onclick="OpenCreate">Nouveau</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="OpenEdit">Modifier</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="HandleDelete">Supprimer</button>
    </div>
</div>

<div class="search-bar">
    <select class="search-input" style="min-width: 200px;" value="@SearchColumn" @onchange="OnSearchColumnChange">
        @foreach (var col in Columns)
        {
            <option value="@col.Key">@col.Label</option>
        }
    </select>
    <input class="search-input" type="text" placeholder="Rechercher…" value="@SearchTerm" @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(SearchTerm))
    {
        <span class="result-count">@Filtered.Count / @Items.Count résultats</span>
    }
</div>

@if (Error is not null)
{
    <div class="alert">@Error</div>
}

@if (Loading)
{
    <p class="dimmed">Chargement…</p>
}
else
{
    <div class="table-wrap" style="overflow-x: auto;">
        <div style="width: @(TotalWidth)px;">
            <div class="header-row" style="position: sticky; top: 0;">
                @foreach (var col in Columns)
                {
                    <div class="cell" style="flex: 0 0 @(col.Width)px;">@col.Label</div>
                }
            </div>
            <Virtualize Items="Filtered" Context="c" ItemSize="34">
                <div class="row @(c.CleOpl == Selected ? "selected" : "")" @onclick="() => Select(c.CleOpl)">
                    @foreach (var col in Columns)
                    {
                        <div class="cell" style="flex: 0 0 @(col.Width)px;">@GetCellText(c, col.Key)</div>
                    }
                </div>
            </Virtualize>
        </div>
    </div>
    <p class="count">@Items.Count enregistrements</p>
}
</div>

@code {
    private record ColumnDef(string Key, string Label, int Width);

    private readonly List<ColumnDef> Columns = new()
    {
        new("cle_opl", "Cle Opl", 80),
        new("famille", "Famille", 140),
        new("raison_sociale", "Raison Sociale", 200),
        new("complement", "Complement", 160),
        new("franchise", "Franchise", 140),
        new("franchise2", "Franchise 2", 140),
        new("franchise3", "Franchise 3", 140),
        new("franchise4", "Franchise 4", 140),
        new("rue", "Rue", 160),
        new("localisation_1", "Localisation 1", 140),
        new("localisation_2", "Localisation 2", 140),
        new("cp", "Code Postal", 90),
        new("ville", "Ville", 140),
        new("pays", "Pays", 120),
        new("telephone", "Telephone", 110),
        new("portable", "Portable", 110),
        new("fax", "Fax", 110),
        new("email", "Email", 180),
        new("assistante_commercial", "Assistante Commerciale", 180),
        new("magasin_principal", "Magasin Principal", 160),
        new("statuts_clients", "Statuts Clients", 140),
        new("representant", "Représentant", 160),
        new("responsable_achat", "Responsable Achat", 160),
        new("op_en_cours", "Opération en Cours", 160),
        new("status_vente", "Status Vente", 140),
        new("date_saisie", "Date Saisie", 100),
        new("heure_saisie", "Heure Saisie", 90),
        new("date_rappel", "Date Rappel", 100),
        new("heure_rappel", "Heure Rappel", 90),
        new("note_perm", "Note Permanente", 200),
        new("etat_client", "État Client", 140),
    };

    private int TotalWidth => Columns.Sum(c => c.Width);

    private List<FranceOptique> Items = new();
    private long? Selected;
    private string SearchColumn = "raison_sociale";
    private string SearchTerm = string.Empty;
    private bool Loading = true;
    private string? Error;

    private List<FranceOptique> Filtered =>
        string.IsNullOrWhiteSpace(SearchTerm)
            ? Items
            : Items.Where(c => GetCellText(c, SearchColumn).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        Selected = null;
        try
        {
            Items = await ClientSvc.ListAsync();
            Error = null;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private void OnSearchColumnChange(ChangeEventArgs e)
    {
        SearchColumn = e.Value?.ToString() ?? "raison_sociale";
        Selected = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        Selected = null;
    }

    private void Select(long cleOpl) => Selected = cleOpl;

    private void OpenCreate() => Nav.NavigateTo("/clients/new");

    private void OpenEdit()
    {
        if (Selected is null) return;
        Nav.NavigateTo($"/clients/{Selected}/edit");
    }

    private async Task HandleDelete()
    {
        if (Selected is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer ce client ?");
        if (!confirmed) return;

        Error = null;
        try
        {
            await ClientSvc.DeleteAsync(Selected.Value);
            await Load();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private static string GetCellText(FranceOptique c, string key) => key switch
    {
        "cle_opl" => c.CleOpl.ToString(),
        "famille" => c.Famille ?? "",
        "raison_sociale" => c.RaisonSociale ?? "",
        "complement" => c.Complement ?? "",
        "franchise" => c.Franchise ?? "",
        "franchise2" => c.Franchise2 ?? "",
        "franchise3" => c.Franchise3 ?? "",
        "franchise4" => c.Franchise4 ?? "",
        "rue" => c.Rue ?? "",
        "localisation_1" => c.Localisation1 ?? "",
        "localisation_2" => c.Localisation2 ?? "",
        "cp" => c.Cp ?? "",
        "ville" => c.Ville ?? "",
        "pays" => c.Pays ?? "",
        "telephone" => c.Telephone ?? "",
        "portable" => c.Portable ?? "",
        "fax" => c.Fax ?? "",
        "email" => c.Email ?? "",
        "assistante_commercial" => c.AssistanteCommercial ?? "",
        "magasin_principal" => c.MagasinPrincipal ?? "",
        "statuts_clients" => c.StatutsClients ?? "",
        "representant" => c.Representant ?? "",
        "responsable_achat" => c.ResponsableAchat ?? "",
        "op_en_cours" => c.OpEnCours ?? "",
        "status_vente" => c.StatusVente ?? "",
        "date_saisie" => c.DateSaisie?.ToString("dd/MM/yyyy") ?? "",
        "heure_saisie" => c.HeureSaisie?.ToString("HH:mm") ?? "",
        "date_rappel" => c.DateRappel?.ToString("dd/MM/yyyy") ?? "",
        "heure_rappel" => c.HeureRappel?.ToString("HH:mm") ?? "",
        "note_perm" => c.NotePerm ?? "",
        "etat_client" => c.EtatClient ?? "",
        _ => "",
    };
}
