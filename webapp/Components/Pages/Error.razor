@page "/Error"
@using System.Diagnostics

<PageTitle>Erreur</PageTitle>

<h1 class="text-danger">Une erreur s'est produite.</h1>
<h2 class="text-danger">Votre demande n'a pas pu être traitée. Veuillez réessayer.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Identifiant de la requête :</strong> <code>@RequestId</code>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
