@page "/bon-commande-en-cours"
@inject BonCommandeEnCoursService BonCommandeSvc
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

@* "Voir tout" target for the dashboard's "Bon de commande en cours"
   section — same grid/sort/filter shape as Rappels.razor, just a
   different query (BonCommandeEnCoursService: StatusVente == "Vente
   (Bon de Commande)", per-user). No legacy equivalent — this status
   previously had no dedicated per-assistant worklist at all. *@

<PageTitle>Bon de Commande en cours</PageTitle>

<div class="page page-flush">
<div class="toolbar">
    <span class="title">Bon de Commande en cours</span>
    <div class="actions">
        <button class="btn btn-outline" @onclick="Load">Actualiser</button>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert">@Error</div>
}

@if (Loading)
{
    <p class="dimmed">Chargement…</p>
}
else if (Items.Count == 0)
{
    <p class="dimmed">Aucun bon de commande en cours.</p>
}
else
{
    <GridFilterClearAll Filter="Filter" OnFilterChanged="StateHasChanged" />
    <div class="table-wrap" style="overflow-x: auto;">
        <div style="@GridLayout.WrapperStyle(TotalWidth)">
            <div class="header-row" style="position: sticky; top: 0;">
                @foreach (var col in Columns)
                {
                    <div class="cell @Sort.CssClass(col.Key)" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])" @onclick='() => Sort.Toggle(col.Key)'>
                        @col.Label @Sort.ArrowFor(col.Key)
                        <ColumnFilterIcon Column="@col.Key" Label="@col.Label" Filter="Filter" OnFilterChanged="StateHasChanged" />
                    </div>
                }
            </div>
            @foreach (var c in SortedItems)
            {
                <div class="row" @onclick="() => OpenParcours(c.CleOpl)">
                    @foreach (var col in Columns)
                    {
                        <div class="cell" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])">
                            @GetCellText(c, col.Key)
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <p class="count">@Items.Count bon@(Items.Count != 1 ? "s" : "") de commande en cours</p>
}
</div>

@code {
    private record ColumnDef(string Key, string Label, int Width);

    private readonly List<ColumnDef> Columns = new()
    {
        new("date_saisie", "Date Saisie", 200),
        new("heure_saisie", "Heure Saisie", 90),
        new("cle_opl", "Cle Opl", 80),
        new("raison_sociale", "Raison Sociale", 220),
        new("assistante_commercial", "Assistante Commerciale", 180),
        new("telephone", "Telephone", 110),
        new("note", "Note", 260),
    };

    private int TotalWidth => Columns.Sum(c => c.Width);

    private List<FranceOptique> Items = new();
    private bool Loading = true;
    private string? Error;
    private readonly SortState Sort = new();
    private readonly GridFilterState Filter = new();

    private List<FranceOptique> SortedItems => GridSort.Apply(GridFilter.Apply(Items, Filter, GetCellText), Sort, GetCellText);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        try
        {
            var login = await CurrentUser.GetLoginAsync();
            Items = login is null ? new() : await BonCommandeSvc.ListAsync(login);
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Loading = false;
        }
    }

    private void OpenParcours(long cleOpl) => Nav.NavigateTo($"/parcours-client?mode=clients&start={cleOpl}");

    private static string GetCellText(FranceOptique c, string key) => key switch
    {
        "date_saisie" => c.DateSaisie?.ToString("dd/MM/yyyy") ?? "",
        "heure_saisie" => c.HeureSaisie?.ToString("HH:mm") ?? "",
        "cle_opl" => c.CleOpl.ToString(),
        "raison_sociale" => c.RaisonSociale ?? "",
        "assistante_commercial" => c.AssistanteCommercial ?? "",
        "telephone" => c.Telephone ?? "",
        "note" => c.Note ?? "",
        _ => "",
    };
}
