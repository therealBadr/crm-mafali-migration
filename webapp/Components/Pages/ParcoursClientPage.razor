@* Mirrors Fiche_CA — a real grid (TABLE_CA/REQ_Tout_CA) over every year's
   revenue for this client, not a single "current year" editor. One
   deliberate adaptation from the legacy: the doc's own BTN_Valider saves
   the SAI_Année/SAI_CA fields as one record and closes the *entire* window,
   which would mean reopening this modal to add a second year — instead,
   Nouveau/Modifier open an inline Année/Chiffre d'affaire form scoped to one
   row (matching this app's existing Familles/Franchises/Assistantes list
   pattern), Valider there saves just that row and returns to the grid, and
   "Fermer" closes the whole modal whenever done browsing/editing. Delete
   confirmation text ("Voulez-vous vraiment Supprimer ce CA ?") kept verbatim
   from the legacy. *@
@if (CaModalOpen && !CaConflictDialogOpen)
{
    <div class="modal-backdrop" @onclick="() => CaModalOpen = false">
        <div class="modal" style="width: 560px; max-width: 90vw;" @onclick:stopPropagation="true">
            <h3>Chiffre d'Affaire</h3>

            <div class="table-wrap" style="max-height: 220px; border: 1px solid var(--border-light); border-radius: 4px; margin-bottom: 12px;">
                <div class="header-row" style="position: sticky; top: 0;">
                    <div class="cell" style="flex: 0 0 90px;">Cle Opl</div>
                    <div class="cell" style="flex: 0 0 90px;">Année</div>
                    <div class="cell" style="flex: 1;">Chiffre d'Affaire</div>
                    <div class="cell" style="flex: 0 0 90px;">ID CA</div>
                </div>
                @if (CaList.Count == 0)
                {
                    <p class="dimmed">Aucun chiffre d'affaire enregistré.</p>
                }
                else
                {
                    @foreach (var ca in CaList)
                    {
                        <div class="row @(ca.IdCa == CaSelectedIdCa ? "selected" : "")" @onclick="() => CaSelectedIdCa = ca.IdCa">
                            <div class="cell" style="flex: 0 0 90px;">@ca.CleOpl</div>
                            <div class="cell" style="flex: 0 0 90px;">@ca.Annee</div>
                            <div class="cell" style="flex: 1;">@(ca.Ca1?.ToString() ?? "0")</div>
                            <div class="cell" style="flex: 0 0 90px;">@ca.IdCa</div>
                        </div>
                    }
                }
            </div>

            @if (CaEditFormOpen)
            {
                <div class="pc-field-row">
                    <div class="pc-field">
                        <label>Année</label>
                        <input class="text-input" type="number" value="@CaEditAnnee"
                               @oninput="e => CaEditAnnee = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                    <div class="pc-field">
                        <label>Chiffre d'affaire</label>
                        <input class="text-input" type="number" value="@CaEditMontant"
                               @oninput="e => CaEditMontant = int.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                    </div>
                </div>
                @if (CaError is not null)
                {
                    <div class="alert">@CaError</div>
                }
                <div class="modal-actions" style="margin-bottom: 10px;">
                    <button class="btn btn-default" @onclick="() => CaEditFormOpen = false">Annuler</button>
                    <button class="btn btn-primary" disabled="@Submitting" @onclick="ConfirmCaEdit">Valider</button>
                </div>
            }
            else
            {
                <div class="modal-actions" style="justify-content: flex-start; margin-bottom: 10px;">
                    <button class="btn btn-primary" @onclick="OpenCaNew">Nouveau</button>
                    <button class="btn btn-default" disabled="@(CaSelectedIdCa is null)" @onclick="OpenCaEdit">Modifier</button>
                    <button class="btn btn-default" disabled="@(CaSelectedIdCa is null)" @onclick="() => CaConfirmDeleteOpen = true">Supprimer</button>
                </div>
            }

            <div class="modal-actions">
                <button class="btn btn-default" @onclick="() => CaModalOpen = false">Fermer</button>
            </div>
        </div>
    </div>
}

