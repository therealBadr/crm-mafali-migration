@code {
    private static readonly string[] ProductionStages =
    {
        "En test", "Test couleur valide date", "A imprimer", "imprimé",
        "Calandré", "Conditionné", "Facture", "Livré",
    };

    private record ColumnDef(string Key, string Label, int Width);

    // Order from the real Fen_Parcours_Client doc's own numbered
    // Table_Histo column list, columns 1-9 — deliberately dropped the
    // legacy's 10th, Id_Histo: it's just the row's internal database
    // surrogate key, not a business-meaningful value staff would ever
    // read or reference (unlike N° Client), and it already doubles as
    // the row's selection key (SelectedHistoId below) without needing to
    // be a visible column for that.
    private readonly List<ColumnDef> HistoColumns = new()
    {
        new("num_client", "N° Client", 90),
        new("date_saisie", "Date Saisie", 100),
        new("heure_saisie", "Heure Saisie", 90),
        new("assistante_commercial", "Assistante Commerciale", 180),
        new("date_rappel", "Date Rappel", 100),
        new("heure_rappel", "Heure Rappel", 90),
        new("operation", "Opération", 220),
        new("status_vente", "Status Vente", 140),
        new("note", "Note", 260),
    };

    private int HistoTotalWidth => HistoColumns.Sum(c => c.Width);

    // Every column stays a fixed width except Note, which grows to absorb
    // whatever space is left over — otherwise, whenever the grid is wider
    // than its declared column total (the common case: only 10 narrow
    // columns here, unlike the 30+-column grids elsewhere in this app that
    // usually need horizontal scroll regardless), that leftover space just
    // sits empty between Note and Id_Histo instead of being part of any
    // column, which reads as a layout bug even though nothing was
    // technically broken.
    private static string HistoCellFlex(string key) => key == "note" ? "1 1" : "0 0";

    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "assistante")]
    public string? QueryAssistante { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "filtre")]
    public string? QueryFiltre { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "criteria")]
    public string? QueryCriteria { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "start")]
    public long? Start { get; set; }

    private List<long> ClientIds = new();
    private int CurrentIndex;
    private FranceOptique? Client;
    private ParcoursClientInput? Baseline;
    private List<Ca> CaList = new();
    private List<Historique> HistoList = new();
    private long? SelectedHistoId;

    private List<string> FamilleOptions = new();
    private List<string> FranchiseOptions = new();
    private List<string> PaysOptions = new();
    private Dictionary<string, PaysModel> PaysByName = new();
    private List<string> AssistanteOptions = new();

    private bool InterMajClient;
    private bool InterModifNote;
    private bool ShowProduction;

    private bool Loading = true;
    private bool Submitting;
    private string? Error;
    private string? InfoMessage;

    private bool ConfirmApplyOpen;
    private bool ConflictDialogOpen;
    private List<FieldConflict> Conflicts = new();
    private bool MonthsPromptOpen;
    private int MonthsValue = 1;
    private bool DatePromptOpen;
    private DateOnly DatePromptValue = DateOnly.FromDateTime(DateTime.Today);

    // 20 MB, matching Clients.razor's Excel-import cap (MaxImportFileSize)
    // — same reasoning: comfortably above any realistic devis/BAT/bon de
    // commande scan, just a sanity ceiling.
    private const long MaxAttachmentFileSize = 20 * 1024 * 1024;
    private static readonly HashSet<string> FileAttachStatuses = new()
    {
        "Devis en cours", "Vente (BAT Signé)", "Vente (BAT Original)", "Vente (Bon de Commande)",
    };
    private bool AttachFilePromptOpen;
    private string? PreviousStatusVente;
    private byte[]? PendingAttachmentBytes;
    private string? PendingAttachmentFileName;

    private bool BcChoiceOpen;
    private bool BcGenerating;
    private string? BcError;
    private bool BcOpenPromptOpen;
    private string? BcSuccessFolder;
    private byte[]? PendingBcBytes;
    private string? PendingBcFileName;

    private bool CaModalOpen;
    private long? CaSelectedIdCa;
    private bool CaEditFormOpen;
    private bool CaIsNew;
    private int CaEditAnnee;
    private int? CaEditMontant;
    private int? CaEditOriginalAnnee;
    private bool CaConfirmDeleteOpen;
    private string? CaError;
    private CaInput? CaBaseline;
    private bool CaConflictDialogOpen;
    private List<FieldConflict> CaConflicts = new();

    private bool BlockedGate => Client?.Bloque ?? false;
    private bool MajDisabled => BlockedGate;
    private bool InterModifClientDisabled => BlockedGate || !InterMajClient;
    private bool StatusDisabled => BlockedGate || (!InterMajClient && Client?.OpEnCours != "Vente en Cours");
    private int YearMinus1 => DateTime.Today.Year - 1;
    private int YearMinus2 => DateTime.Today.Year - 2;

    private string? CurrentMask => Client?.Pays is not null && PaysByName.TryGetValue(Client.Pays, out var p) ? p.Masque : null;
    private string? CurrentIndicatif => Client?.Pays is not null && PaysByName.TryGetValue(Client.Pays, out var p) ? p.Indicatif : null;

    private string ReturnUrl => Mode switch
    {
        "filtre" => "/filtres-predefinis",
        "recherche" => "/recherche-client",
        _ => "/clients",
    };

    protected override async Task OnInitializedAsync()
    {
        Loading = true;
        try
        {
            FamilleOptions = await FamilleSvc.ListAsync();
            FranchiseOptions = await FranchiseSvc.ListAsync();
            var paysList = await PaysSvc.ListAsync();
            PaysOptions = paysList.Select(p => p.NomPays).ToList();
            PaysByName = paysList.ToDictionary(p => p.NomPays, p => p);
            AssistanteOptions = (await AssistanteSvc.ListAsync()).Select(a => a.PrenomNom).ToList();

            if (Mode == "filtre" && !string.IsNullOrEmpty(QueryAssistante) && !string.IsNullOrEmpty(QueryFiltre))
            {
                var filtres = await FiltreSvc.ListByOperatorAsync(QueryAssistante);
                var f = filtres.FirstOrDefault(x => x.NomFiltre == QueryFiltre);
                if (f is not null)
                {
                    try
                    {
                        var (rows, _) = await ClientFilterSvc.SearchByFiltreReelAsync(f.FiltreReel ?? "");
                        ClientIds = rows.Select(r => r.CleOpl).ToList();
                    }
                    catch (FormatException)
                    {
                        Error = "Ce filtre contient une syntaxe non reconnue et ne peut pas être exécuté.";
                    }
                }
            }
            else if (Mode == "recherche" && !string.IsNullOrEmpty(QueryCriteria))
            {
                var conditions = JsonSerializer.Deserialize<List<Condition>>(QueryCriteria) ?? new();
                var (rows, _) = await ClientFilterSvc.SearchAsync(conditions);
                ClientIds = rows.Select(r => r.CleOpl).ToList();
            }
            else
            {
                ClientIds = (await ClientSvc.ListAsync()).Select(c => c.CleOpl).ToList();
            }

            if (ClientIds.Count == 0)
            {
                if (Error is null) Error = "Aucun client à afficher.";
                return;
            }

            CurrentIndex = Start.HasValue ? ClientIds.IndexOf(Start.Value) : 0;
            if (CurrentIndex < 0) CurrentIndex = 0;

            await LoadCurrent();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadCurrent()
    {
        var id = ClientIds[CurrentIndex];
        try
        {
            Client = await ClientSvc.GetAsync(id);
            if (Client is null)
            {
                Error = "Client introuvable.";
                return;
            }
            Baseline = ParcoursClientInput.FromEntity(Client);
            CaList = await CaSvc.ListByClientAsync(id);
            HistoList = await HistoriqueSvc.GetForClientAsync(id);
            SelectedHistoId = null;
            InterMajClient = false;
            InterModifNote = false;
            ShowProduction = Client.StatusVente == "Production";
            AttachFilePromptOpen = false;
            PreviousStatusVente = null;
            PendingAttachmentBytes = null;
            PendingAttachmentFileName = null;
            BcChoiceOpen = false;
            BcError = null;
            BcOpenPromptOpen = false;
            BcSuccessFolder = null;
            PendingBcBytes = null;
            PendingBcFileName = null;
            CaModalOpen = false;
            CaSelectedIdCa = null;
            CaEditFormOpen = false;
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
    }

    private async Task GoFirst()
    {
        InfoMessage = null;
        CurrentIndex = 0;
        await LoadCurrent();
    }

    private async Task GoPrevious()
    {
        if (CurrentIndex <= 0)
        {
            InfoMessage = "C'est le premier enregistrement.";
            return;
        }
        InfoMessage = null;
        CurrentIndex--;
        await LoadCurrent();
    }

    private async Task GoNext()
    {
        if (CurrentIndex >= ClientIds.Count - 1)
        {
            InfoMessage = "C'est le dernier enregistrement.";
            return;
        }
        InfoMessage = null;
        CurrentIndex++;
        await LoadCurrent();
    }

    private async Task GoLast()
    {
        InfoMessage = null;
        CurrentIndex = ClientIds.Count - 1;
        await LoadCurrent();
    }

    // Same idea as the |</</>/>| buttons — jumps within the same
    // in-memory ClientIds/CurrentIndex the arrows already use, so it
    // respects whatever list is active (the full client list, a search
    // result set, etc.), not a separate lookup. "Position", not Cle_Opl —
    // matches what the pager already displays (@(CurrentIndex + 1) /
    // @ClientIds.Count), not the client's actual (often large/arbitrary)
    // ID number.
    //
    // @bind-value (typed int?), not a hand-rolled value+@oninput pair —
    // Blazor Server round-trips every keystroke to the server over the
    // same SignalR connection regardless, but @bind-value's own DOM-diffing
    // is more careful about not fighting the browser's own input value
    // mid-edit than a manual value="@GoToInput" re-render is. Also gets
    // numeric parsing for free instead of a separate int.TryParse.
    private int? GoToInput;

    private async Task OnGoToKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GoToPosition();
        }
    }

    private async Task GoToPosition()
    {
        if (GoToInput is not { } n || n < 1 || n > ClientIds.Count)
        {
            InfoMessage = $"Numéro invalide (1 à {ClientIds.Count}).";
            return;
        }
        InfoMessage = null;
        CurrentIndex = n - 1;
        GoToInput = null;
        await LoadCurrent();
    }

    private async Task Cancel() => await LoadCurrent();

    private void Close() => Nav.NavigateTo(ReturnUrl);

    private void OnOperationChange(ChangeEventArgs e)
    {
        if (Client is null) return;
        Client.OpEnCours = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        switch (Client.OpEnCours)
        {
            case "A Rappeler Mois":
                MonthsValue = 1;
                MonthsPromptOpen = true;
                break;
            case "A Rappeler Date":
            case "A Rappeler Date Heure":
                DatePromptValue = DateOnly.FromDateTime(DateTime.Today);
                DatePromptOpen = true;
                break;
            case "Pas Intéressé":
                Client.DateRappel = DateOnly.FromDateTime(DateTime.Today.AddMonths(4));
                break;
            case "Production":
                Client.StatusVente = "Production";
                ShowProduction = true;
                break;
        }
    }

    private void OnStatusChange(ChangeEventArgs e)
    {
        if (Client is null) return;
        var v = e.Value?.ToString();
        var previous = Client.StatusVente;
        Client.StatusVente = v == "-1" ? "-1" : v;
        ShowProduction = Client.StatusVente == "Production";
        if (Client.StatusVente == "Vente Annulée")
        {
            Client.DateRappel = DateOnly.FromDateTime(DateTime.Today.AddMonths(4));
        }

        // Devis en cours / Vente (BAT Signé)/(BAT Original)/(Bon de Commande): the
        // legacy opens a file picker on selection and reverts the status if the
        // user cancels file selection (functional spec line 91). PreviousStatusVente
        // is what CancelAttachPrompt restores on Annuler or a backdrop click —
        // there's no separate "confirm" step, picking a file resolves it, same as
        // an OS file dialog closing on its own "Open" click.
        if (Client.StatusVente is not null && FileAttachStatuses.Contains(Client.StatusVente))
        {
            PreviousStatusVente = previous;
            PendingAttachmentBytes = null;
            PendingAttachmentFileName = null;
            AttachFilePromptOpen = true;
        }
    }

    private void CancelAttachPrompt()
    {
        if (Client is not null)
        {
            Client.StatusVente = PreviousStatusVente;
            ShowProduction = Client.StatusVente == "Production";
        }
        AttachFilePromptOpen = false;
        PendingAttachmentBytes = null;
        PendingAttachmentFileName = null;
    }

    private async Task HandleAttachmentFile(InputFileChangeEventArgs e)
    {
        Error = null;
        try
        {
            using var buffered = new MemoryStream();
            await e.File.OpenReadStream(MaxAttachmentFileSize).CopyToAsync(buffered);
            PendingAttachmentBytes = buffered.ToArray();
            PendingAttachmentFileName = e.File.Name;
            AttachFilePromptOpen = false;
        }
        catch (IOException)
        {
            Error = "Le fichier dépasse la taille maximale autorisée (20 Mo). Choisissez un autre fichier.";
        }
    }

    private async Task DownloadStoredFile()
    {
        if (SelectedHistoId is null) return;
        Error = null;
        var histo = await HistoriqueSvc.GetByIdAsync(SelectedHistoId.Value);
        if (histo?.FicStk is null || histo.FicStk.Length == 0)
        {
            Error = "Aucun fichier n'est associé à cet enregistrement.";
            return;
        }
        using var stream = new MemoryStream(histo.FicStk);
        using var streamRef = new DotNetStreamReference(stream);
        var fileName = string.IsNullOrWhiteSpace(histo.FicStkNom) ? $"fichier_{histo.IdHisto}" : histo.FicStkNom;
        await JS.InvokeVoidAsync("mafaliFileDownload.downloadFileFromStream", fileName, "application/octet-stream", streamRef);
    }

    private const string XlsxContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

    private async Task GenerateBonCommande(BonCommandeTemplateType type)
    {
        if (Client is null) return;
        BcError = null;
        BcGenerating = true;
        try
        {
            var templateBytes = await BcTemplateSvc.GetBytesAsync(type);
            if (templateBytes is null)
            {
                BcError = $"Aucun modèle configuré pour « {(type == BonCommandeTemplateType.Optique ? "Optique" : "Revendeur")} ». Contactez un administrateur.";
                return;
            }

            var filled = await BcTemplateSvc.FillAsync(templateBytes, Client, type);
            var fileName = $"BC_{Client.CleOpl}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            var supported = await JS.InvokeAsync<bool>("mafaliBonCommandeDestination.isSupported");
            var folderName = supported ? await JS.InvokeAsync<string?>("mafaliBonCommandeDestination.getCurrentFolderName") : null;

            if (supported && folderName is not null)
            {
                using var stream = new MemoryStream(filled);
                using var streamRef = new DotNetStreamReference(stream);
                var result = await JS.InvokeAsync<string>("mafaliBonCommandeDestination.writeFile", fileName, streamRef);
                if (result == "ok")
                {
                    BcChoiceOpen = false;
                    PendingBcBytes = filled;
                    PendingBcFileName = fileName;
                    BcSuccessFolder = folderName;
                    BcOpenPromptOpen = true;
                    return;
                }

                // Grant expired/denied, or the write itself failed for some other
                // reason — fall back to a normal download rather than leaving the
                // user stuck, same as the no-folder-chosen-yet path below.
                await DownloadBonCommandeBytes(filled, fileName);
                InfoMessage = "Fichier téléchargé (le dossier configuré n'était plus accessible — vous pouvez le choisir à nouveau depuis la page Bon de Commande).";
            }
            else
            {
                await DownloadBonCommandeBytes(filled, fileName);
                InfoMessage = "Fichier téléchargé.";
            }
            BcChoiceOpen = false;
        }
        catch (Exception ex)
        {
            BcError = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            BcGenerating = false;
        }
    }

    private async Task OpenGeneratedBc()
    {
        BcOpenPromptOpen = false;
        if (PendingBcBytes is not null && PendingBcFileName is not null)
        {
            await DownloadBonCommandeBytes(PendingBcBytes, PendingBcFileName);
        }
        PendingBcBytes = null;
        PendingBcFileName = null;
    }

    private async Task DownloadBonCommandeBytes(byte[] bytes, string fileName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("mafaliFileDownload.downloadFileFromStream", fileName, XlsxContentType, streamRef);
    }

