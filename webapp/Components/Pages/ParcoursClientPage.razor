    }

    private async Task ReloadCaAfterConflict()
    {
        CaConflictDialogOpen = false;
        CaConflicts = new();
        if (Client is null) return;
        CaList = await CaSvc.ListByClientAsync(Client.CleOpl);
        var current = CaList.FirstOrDefault(c => c.Annee == CaEditOriginalAnnee);
        if (current is null) return;
        CaEditAnnee = current.Annee;
        CaEditMontant = current.Ca1;
        CaEditOriginalAnnee = current.Annee;
        CaBaseline = CaInput.FromEntity(current);
    }

    // Validation order/text matches Fiche_CA's BTN_Valider and "Sortie de
    // COL_Année" checks exactly ("Veuillez entrez" typo corrected to
    // "entrer", same as other legacy typos already fixed elsewhere in this
    // app) — "Veuillez saisir une autre année" comes from CaService on a
    // real duplicate-year (unique violation) rather than being checked here.
    private async Task SaveCaAsync(bool force)
    {
        if (Client is null) return;
        CaError = null;
        if (CaEditAnnee <= 0)
        {
            CaError = "Veuillez entrer l'année.";
            return;
        }
        if (CaEditAnnee is < 1000 or > 9999)
        {
            CaError = "Veuillez entrer une année valide.";
            return;
        }
        if (CaEditMontant is null)
        {
            CaError = "Veuillez entrer le chiffre d'affaire.";
            return;
        }

        Submitting = true;
        try
        {
            if (CaIsNew)
            {
                await CaSvc.CreateAsync(Client.CleOpl, CaEditAnnee, CaEditMontant);
            }
            else
            {
                if (CaBaseline is null) return;
                var current = new CaInput { Annee = CaEditAnnee, Montant = CaEditMontant };
                var result = await CaSvc.UpdateWithConflictCheckAsync(Client.CleOpl, CaEditOriginalAnnee!.Value, CaBaseline, current, force);
                if (!result.Success)
                {
                    CaConflicts = result.Conflicts;
                    CaConflictDialogOpen = true;
                    return;
                }
            }
            CaList = await CaSvc.ListByClientAsync(Client.CleOpl);
            CaEditFormOpen = false;
            CaSelectedIdCa = null;
        }
        catch (Exception ex)
        {
            CaError = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Submitting = false;
        }
    }

    private async Task ConfirmCaDelete()
    {
        if (Client is null || CaSelectedIdCa is null) return;
        var selected = CaList.FirstOrDefault(c => c.IdCa == CaSelectedIdCa);
        if (selected is null)
        {
            CaConfirmDeleteOpen = false;
            return;
        }

        Submitting = true;
        try
        {
            await CaSvc.DeleteAsync(Client.CleOpl, selected.Annee);
            CaList = await CaSvc.ListByClientAsync(Client.CleOpl);
            CaSelectedIdCa = null;
            CaConfirmDeleteOpen = false;
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
            CaConfirmDeleteOpen = false;
        }
        finally
        {
            Submitting = false;
        }
    }

